DEFAULT_VOICE=anna
DEFAULT_LANGUAGE=de-CH
DEFAULT_DIALECT=zurich
UPSTREAM_TIMEOUT_SECONDS=120

# Default: clients use their Suisse Speech API key directly as their Bearer key.
# Alternatively keep the provider key on the server and require a separate client key:
# SUISSE_SPEECH_API_KEY=sv_your_key
# ADAPTER_API_KEY=replace-with-a-long-random-secret

# Optional OpenAI-to-Suisse voice overrides. Unmapped OpenAI voices use DEFAULT_VOICE.
# VOICE_ALIASES={"alloy":"anna"}
